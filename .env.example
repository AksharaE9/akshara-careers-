# ─── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres — HTTP driver URL (one-shot queries; no pooling in module scope)
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─── File Storage — Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=akshara-resumes
# S3-compatible endpoint (not the r2.dev preview URL — bucket is NEVER public)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ─── Bot Protection — Cloudflare Turnstile ────────────────────────────────────
# Obtain from dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...    # safe in client bundle
TURNSTILE_SECRET_KEY=0x4AAAAAAA...              # NEVER expose client-side

# ─── Rate Limiting — Upstash Redis ───────────────────────────────────────────
# REST API (HTTP-based — not a TCP connection string)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Email — Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
# Verified sending domain — must have SPF, DKIM, and DMARC configured on akshara.in
# gmail.com sender fails DMARC alignment and goes to spam.
HR_EMAIL_FROM=Akshara Careers <careers@akshara.in>

# ─── HR Application Notifications ────────────────────────────────────────────
# Comma-separated list of validated recipient addresses.
# If unset or empty, code logs loudly and sends nothing — no fallback address.
HR_NOTIFICATION_RECIPIENTS=hr@akshara.in,recruitment@akshara.in
# Set to false to strip candidate phone and email from the notification body
# (DPDP mitigation for orgs that want contact details behind a login only).
HR_EMAIL_INCLUDE_CONTACT=true

# ─── Cron jobs ────────────────────────────────────────────────────────────────
# Protect /api/cron/* endpoints. Generate: openssl rand -hex 32
CRON_SECRET=generate-a-random-hex-string-here

# ─── Auth — Auth.js v5 (console only) ────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your-32-char-base64-secret
AUTH_URL=https://careers.akshara.in          # must match deployed origin exactly

# ─── Security ─────────────────────────────────────────────────────────────────
# Server-side pepper for IP/UA hashing — NEVER change after first deploy
# (changing this invalidates all existing hashes in the audit log)
# Generate: openssl rand -hex 32
HASH_PEPPER=your-64-char-hex-string

# HMAC-SHA256 secret for signed form-mount timestamps (L2 bot protection)
# Generate: openssl rand -hex 16
FORM_TIMESTAMP_SECRET=your-32-char-hex-string

# ─── Monitoring — Sentry ──────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=akshara-careers
SENTRY_AUTH_TOKEN=sntrys_...

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://careers.akshara.in   # http://localhost:3000 for local
# Set to 'true' to enable @next/bundle-analyzer output
ANALYZE=false
