# ==============================================================================
# Akshara Careers — Production Environment Template (.env)
# ==============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── File Storage — Cloudflare R2 ─────────────────────────────────────────────
# Credentials for candidate resume uploads & reap-orphaned-uploads cron
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=akshara-resumes
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ─── Bot Protection — Cloudflare Turnstile ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...    # Safe for client bundle
TURNSTILE_SECRET_KEY=0x4AAAAAAA...              # NEVER expose to client

# ─── Rate Limiting — Upstash Redis ────────────────────────────────────────────
# HTTP-based REST API (limiter throws at boot in production if missing)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Email — Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
HR_EMAIL_FROM=Akshara Careers <careers@akshara.in>
HR_NOTIFICATION_RECIPIENTS=hr@akshara.in,recruitment@akshara.in
HR_EMAIL_INCLUDE_CONTACT=true

# ─── Cron Security ────────────────────────────────────────────────────────────
# Header verification Bearer token (Generate: openssl rand -hex 32)
CRON_SECRET=generate-a-random-hex-string-here

# ─── Authentication (Auth.js v5) ──────────────────────────────────────────────
# Used by NextAuth for cookie encryption (Generate: openssl rand -base64 32)
AUTH_SECRET=your-32-char-base64-secret
# canonical deployed origin URL (no trailing slash)
AUTH_URL=https://careers.akshara.in

# ─── Monitoring — Sentry ──────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=akshara-careers
SENTRY_AUTH_TOKEN=sntrys_...

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://careers.akshara.in
ANALYZE=false
