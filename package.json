{
  "name": "akshara-careers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:design": "playwright test tests/e2e/design-integrity.spec.ts",
    "test:security": "playwright test --config=playwright.security.config.ts",
    "load:drive": "k6 run scripts/load-drive-spike.js",
    "load:double": "cross-env K6_PROFILE=double k6 run scripts/load-drive-spike.js",
    "load:soak": "cross-env K6_PROFILE=soak k6 run scripts/load-drive-spike.js",
    "load:breakpoint": "cross-env K6_PROFILE=breakpoint k6 run scripts/load-drive-spike.js",
    "db:audit": "tsx scripts/db-audit.ts",
    "audit:perf": "tsx scripts/audit-performance.ts",
    "qa": "bash scripts/qa.sh",
    "probe:health": "curl -s http://localhost:3000/api/health | node -e \"process.stdin.resume();let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>console.log(JSON.stringify(JSON.parse(d),null,2)))\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@react-email/render": "^1.1.3",
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "nuqs": "^2.9.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.0",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true
  }
}
